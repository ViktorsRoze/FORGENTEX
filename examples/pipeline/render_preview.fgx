# visual.0: fixed seed -> validated ScenePlan -> deterministic persisted PPM.

share preview_seed: i32 = 7

@repr(C)
struct ScenePlan:
    width: i32
    height: i32
    seed: i32
    glyph_count: i32

share scene_plan: ScenePlan
share preview_image: Vec[u8]

foreign plan_preview c version "c11" effects [cpu]:
    input seed: i32
    output scene: ScenePlan
    sandbox "fs.none"
    bind preview_seed read
    bind scene_plan rw
    code:
        #include "types.h"

        ScenePlan plan_preview(int32_t seed) {
            ScenePlan scene;
            scene.width = 16;
            scene.height = 16;
            scene.seed = seed;
            scene.glyph_count = 12;
            return scene;
        }

foreign render_ppm_preview c version "c11" effects [alloc, cpu.render, fs.write]:
    input scene: ScenePlan
    output image: Vec[u8]
    sandbox "fs.write target/render-previews"
    sandbox "limit.wall_ms 2000"
    sandbox "limit.cpu_ms 1000"
    sandbox "limit.mem_mb 64"
    sandbox "artifact.media_type image/x-portable-pixmap"
    sandbox "artifact.max_bytes 1048576"
    sandbox "artifact.path target/render-previews/visualizer-preview.ppm"
    sandbox "render.profile preview"
    sandbox "render.seed_field seed"
    bind scene_plan read
    bind preview_image rw
    code:
        #include "types.h"
        #include <stdio.h>
        #include <stdlib.h>

        FgxOwnedU8 render_ppm_preview(ScenePlan scene) {
            FgxOwnedU8 result = { NULL, 0, 0 };
            if (scene.width <= 0 || scene.height <= 0) return result;
            int header_len = snprintf(NULL, 0, "P6\n%d %d\n255\n", scene.width, scene.height);
            if (header_len <= 0) return result;
            size_t pixels = (size_t)scene.width * (size_t)scene.height;
            if (pixels > (SIZE_MAX - (size_t)header_len) / 3) return result;
            result.len = (size_t)header_len + pixels * 3;
            result.capacity = result.len;
            result.ptr = (uint8_t *)malloc(result.len);
            if (result.ptr == NULL) {
                result.len = 0;
                result.capacity = 0;
                return result;
            }
            snprintf((char *)result.ptr, (size_t)header_len + 1, "P6\n%d %d\n255\n", scene.width, scene.height);
            for (int32_t y = 0; y < scene.height; ++y) {
                for (int32_t x = 0; x < scene.width; ++x) {
                    size_t offset = (size_t)header_len + ((size_t)y * (size_t)scene.width + (size_t)x) * 3;
                    result.ptr[offset] = (uint8_t)(x * 13 + scene.seed * 17);
                    result.ptr[offset + 1] = (uint8_t)(y * 11 + scene.glyph_count * 19);
                    result.ptr[offset + 2] = (uint8_t)((x + y) * 7 + scene.seed);
                }
            }
            return result;
        }

        void render_ppm_preview_free(uint8_t *ptr, size_t len, size_t capacity) {
            (void)len;
            (void)capacity;
            free(ptr);
        }
