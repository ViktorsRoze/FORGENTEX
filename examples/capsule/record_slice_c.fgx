# Native data boundaries: C borrows a runner-owned slice of reviewed records.

@repr(C)
struct InputRecord:
    id: u64
    delta: i32
    score: f64

foreign last_record_id_c c version "c11":
    input records: &[InputRecord]
    output id: u64
    sandbox "fs.none"
    code:
        #include "types.h"

        uint64_t last_record_id_c(const InputRecord *records, size_t records_len) {
            return records_len == 0 ? 0 : records[records_len - 1].id;
        }

fn last_id_c(records: &[InputRecord]) -> u64:
    return last_record_id_c(records)
