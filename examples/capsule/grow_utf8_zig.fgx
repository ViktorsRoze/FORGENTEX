foreign grow_utf8_zig zig version "0.14":
    input text: &mut String
    output length: usize
    sandbox "fs.none"
    code:
        pub export fn grow_utf8_zig(
            text: [*]u8,
            text_len: *usize,
            text_capacity: usize,
        ) usize {
            if (text_len.* >= text_capacity) return text_len.*;
            text[text_len.*] = '!';
            text_len.* += 1;
            return text_len.*;
        }

fn grow_twice_from_zig(text: &mut String) -> usize:
    let first_length: usize = grow_utf8_zig(text)
    return grow_utf8_zig(text)
