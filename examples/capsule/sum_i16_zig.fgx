# Zig read-only slice: a bounded temporary pointer plus usize length.

foreign sum_i16_zig zig version "0.14" effects [cpu.avx2]:
    input samples: &[i16]
    output total: i32
    sandbox "fs.none"
    code:
        pub export fn sum_i16_zig(samples: [*]const i16, samples_len: usize) i32 {
            var total: i32 = 0;
            for (samples[0..samples_len]) |sample| total += sample;
            return total;
        }

fn sum_with_zig(samples: &[i16]) -> i32 effects [cpu.avx2]:
    return sum_i16_zig(samples)
