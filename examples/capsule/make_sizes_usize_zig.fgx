# Native data boundaries: Zig returns an owned pointer-width unsigned Vec[usize].

foreign make_sizes_usize_zig zig version "0.17" effects [alloc]:
    input count: i32
    output sizes: Vec[usize]
    sandbox "fs.none"
    code:
        const std = @import("std");

        pub const FgxOwnedUsize = extern struct {
            ptr: ?[*]usize,
            len: usize,
            capacity: usize,
        };

        pub export fn make_sizes_usize_zig(count: i32) FgxOwnedUsize {
            const len: usize = @intCast(@max(count, 0));
            if (len == 0) return .{ .ptr = null, .len = 0, .capacity = 0 };
            const values = std.heap.page_allocator.alloc(usize, len) catch
                return .{ .ptr = null, .len = 0, .capacity = 0 };
            for (values, 0..) |*value, index| {
                value.* = if (index + 1 == len) std.math.maxInt(usize) else index * 3_000_000_000;
            }
            return .{ .ptr = values.ptr, .len = values.len, .capacity = values.len };
        }

        pub export fn make_sizes_usize_zig_free(
            ptr: ?[*]usize,
            len: usize,
            capacity: usize,
        ) void {
            _ = len;
            if (ptr) |values| std.heap.page_allocator.free(values[0..capacity]);
        }

fn sizes_from_zig(count: i32) -> Vec[usize] effects [alloc]:
    return make_sizes_usize_zig(count)
