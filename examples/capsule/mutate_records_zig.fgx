# Native data boundaries: Zig mutates a runner-owned fixed-length record slice.

@repr(C)
struct MutableRecord:
    id: u64
    delta: i32
    score: f64

foreign mutate_records_zig zig version "0.17":
    input records: &mut [MutableRecord]
    output changed: u64
    sandbox "fs.none"
    code:
        const std = @import("std");

        pub const MutableRecord = extern struct {
            id: u64,
            delta: i32,
            score: f64,
        };

        pub export fn mutate_records_zig(records: [*]MutableRecord, records_len: usize) u64 {
            if (records_len > 0) records[0].delta = -17;
            if (records_len > 1) {
                records[1].id = std.math.maxInt(u64);
                records[1].score = 42.5;
            }
            return records_len;
        }

fn mutate_then_last_zig(records: &mut [MutableRecord]) -> u64:
    let changed: u64 = mutate_records_zig(records)
    return records[1].id
