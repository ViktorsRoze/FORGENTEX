# Native data boundaries: a fixed-size array of reviewed structs crosses C by value.

@repr(C)
struct NativePoint:
    x: i16
    y: i16

@repr(C)
struct PointBatch:
    id: i32
    points: [NativePoint; 3]

foreign shift_points_c c version "c11":
    input batch: PointBatch
    output shifted: PointBatch
    sandbox "fs.none"
    code:
        #include "types.h"

        PointBatch shift_points_c(PointBatch batch) {
            for (size_t index = 0; index < 3; ++index) {
                batch.points[index].x += (int16_t)(index + 1);
                batch.points[index].y -= (int16_t)(index + 1);
            }
            return batch;
        }

fn shift_points(batch: PointBatch) -> PointBatch:
    return shift_points_c(batch)
