# Native-call v1.24: Zig receives the same borrowed UTF-8 pointer-length ABI.

foreign checksum_utf8_zig zig version "0.17" effects [cpu.avx2]:
    input text: str
    output checksum: i32
    sandbox "fs.none"
    code:
        pub export fn checksum_utf8_zig(text: [*]const u8, text_len: usize) i32 {
            var checksum: i32 = 0;
            for (text[0..text_len]) |byte| checksum += byte;
            return checksum;
        }

fn checksum_live_zig(text: str) -> i32 effects [cpu.avx2]:
