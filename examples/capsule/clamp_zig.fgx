    code:
        pub export fn clamp_zig(x: f32) i16 {
            if (x > 32767.0) return 32767;
            if (x < -32768.0) return -32768;
            return @intFromFloat(x);
        }

fn clamp_with_zig(x: f32) -> i16 effects [cpu.avx2]:
