        #[unsafe(no_mangle)]
        pub unsafe extern "C" fn make_greeting_rust_free(
            ptr: *mut u8,
            len: usize,
            capacity: usize,
        ) {
            if capacity > 0 {
                drop(unsafe { Vec::from_raw_parts(ptr, len, capacity) });
            }
        }

