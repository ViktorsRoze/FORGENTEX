# Native data boundaries: a fixed-size array of reviewed structs crosses pinned Zig 0.14.

@repr(C)
struct NativePoint:
    x: i16
    y: i16

@repr(C)
struct PointBatch:
    id: i32
    points: [NativePoint; 3]

foreign shift_points_zig zig version "0.14":
    input batch: PointBatch
    output shifted: PointBatch
    sandbox "fs.none"
    code:
        pub const NativePoint = extern struct {
            x: i16,
            y: i16,
        };

        pub const PointBatch = extern struct {
            id: i32,
            points: [3]NativePoint,
        };

        pub export fn shift_points_zig(batch: PointBatch) PointBatch {
            var shifted = batch;
            for (&shifted.points, 0..) |*point, index| {
                const delta: i16 = @intCast(index + 1);
                point.x += delta;
                point.y -= delta;
            }
            return shifted;
        }

fn shift_points(batch: PointBatch) -> PointBatch:
    return shift_points_zig(batch)
