# Native data boundaries: Zig borrows a runner-owned slice of reviewed records.

@repr(C)
struct InputRecord:
    id: u64
    delta: i32
    score: f64

foreign last_record_id_zig zig version "0.14":
    input records: &[InputRecord]
    output id: u64
    sandbox "fs.none"
    code:
        pub const InputRecord = extern struct {
            id: u64,
            delta: i32,
            score: f64,
        };

        pub export fn last_record_id_zig(records: [*]const InputRecord, records_len: usize) u64 {
            return if (records_len == 0) 0 else records[records_len - 1].id;
        }

fn last_id_zig(records: &[InputRecord]) -> u64:
    return last_record_id_zig(records)
