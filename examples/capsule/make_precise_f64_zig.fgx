# Native data boundary: pinned Zig transfers a precision-sensitive owned Vec[f64].

foreign make_precise_f64_zig zig version "0.14" effects [alloc]:
    output values: Vec[f64]
    sandbox "fs.none"
    code:
        const std = @import("std");

        pub const FgxOwnedF64 = extern struct {
            ptr: ?[*]f64,
            len: usize,
            capacity: usize,
        };

        pub export fn make_precise_f64_zig() FgxOwnedF64 {
            const values = std.heap.page_allocator.alloc(f64, 4) catch
                return .{ .ptr = null, .len = 0, .capacity = 0 };
            values[0] = 1.0000000000000002;
            values[1] = -2.5;
            values[2] = 0.0;
            values[3] = 3.141592653589793;
            return .{ .ptr = values.ptr, .len = values.len, .capacity = values.len };
        }

        pub export fn make_precise_f64_zig_free(
            ptr: ?[*]f64,
            len: usize,
            capacity: usize,
        ) void {
            _ = len;
            if (ptr) |values| std.heap.page_allocator.free(values[0..capacity]);
        }

fn precise_from_zig() -> Vec[f64] effects [alloc]:
    return make_precise_f64_zig()
