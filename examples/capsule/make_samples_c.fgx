# Native-call v1.19: a typed owned i16 buffer crosses by descriptor and copy.

foreign make_samples_c c version "c11" effects [alloc, cpu.avx2]:
    input count: i32
    output samples: Vec[i16]
    sandbox "fs.none"
    code:
        #include "types.h"
        #include <stdint.h>
        #include <stdlib.h>

        FgxOwnedI16 make_samples_c(int32_t count) {
            FgxOwnedI16 result = { NULL, 0, 0 };
            if (count <= 0) return result;
            result.ptr = (int16_t *)malloc((size_t)count * sizeof(int16_t));
            if (result.ptr == NULL) return result;
            result.len = (size_t)count;
            result.capacity = (size_t)count;
            for (size_t i = 0; i < result.len; ++i) {
                result.ptr[i] = (int16_t)(((int32_t)i - 2) * 100);
            }
            return result;
        }

        void make_samples_c_free(int16_t *ptr, size_t len, size_t capacity) {
            (void)len;
            (void)capacity;
            free(ptr);
        }

fn samples_from_c(count: i32) -> Vec[i16] effects [alloc, cpu.avx2]:
    return make_samples_c(count)
