# native-call v1.10: a reviewed scalar-field extern struct crosses Zig by
# value in both directions with an exact Forgentex declaration match.

@repr(C)
struct RenderParams:
    width: i32
    height: i32
    exposure: f32

foreign adjust_render_params_zig zig version "0.17" effects [cpu.avx2]:
    input params: RenderParams
    output adjusted: RenderParams
    sandbox "fs.none"
    code:
        pub const RenderParams = extern struct {
            width: i32,
            height: i32,
            exposure: f32,
        };

        pub export fn adjust_render_params_zig(params: RenderParams) RenderParams {
            return .{
                .width = params.width + 16,
                .height = params.height + 9,
                .exposure = params.exposure * 2.0,
            };
        }

fn adjust_render_params_with_zig(params: RenderParams) -> RenderParams effects [cpu.avx2]:
    return adjust_render_params_zig(params)
