# Native data boundaries: Rust returns an owned buffer of reviewed records.

@repr(C)
struct NativeRecord:
    id: u64
    delta: i32
    score: f64

foreign make_records_rust rust version "2021" effects [alloc]:
    output records: Vec[NativeRecord]
    sandbox "fs.none"
    code:
        #[repr(C)]
        pub struct NativeRecord {
            pub id: u64,
            pub delta: i32,
            pub score: f64,
        }

        #[repr(C)]
        pub struct FgxOwnedNativeRecord {
            pub ptr: *mut NativeRecord,
            pub len: usize,
            pub capacity: usize,
        }

        #[unsafe(no_mangle)]
        pub extern "C" fn make_records_rust() -> FgxOwnedNativeRecord {
            let mut records = vec![
                NativeRecord { id: 7, delta: -3, score: 1.25 },
                NativeRecord { id: u64::MAX, delta: 9, score: -2.5 },
            ];
            let result = FgxOwnedNativeRecord {
                ptr: records.as_mut_ptr(),
                len: records.len(),
                capacity: records.capacity(),
            };
            std::mem::forget(records);
            result
        }

        #[unsafe(no_mangle)]
        pub unsafe extern "C" fn make_records_rust_free(
            ptr: *mut NativeRecord,
            len: usize,
            capacity: usize,
        ) {
            if capacity > 0 {
                drop(Vec::from_raw_parts(ptr, len, capacity));
            }
        }

fn records_rust() -> Vec[NativeRecord]:
    return make_records_rust()
