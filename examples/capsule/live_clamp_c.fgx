# native-call v1: a checked C scalar capsule invoked from `fgx run --live`.
# It executes in a generated child runner, never in the interpreter process.

foreign clamp_sample c version "c11" effects [cpu.avx2]:
    input x: f32
    output y: i16
    sandbox "fs.none"
    mock 40000.0 -> 32767
    mock -40000.0 -> -32768
    mock 100.0 -> 100
    code:
        short clamp_sample(float x) {
            if (x > 32767.0f) return 32767;
            if (x < -32768.0f) return -32768;
            return (short)x;
        }

fn clamp_live(x: f32) -> i16 effects [cpu.avx2]:
    return clamp_sample(x)
