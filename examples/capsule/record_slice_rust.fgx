# Native data boundaries: Rust borrows a runner-owned slice of reviewed records.

@repr(C)
struct InputRecord:
    id: u64
    delta: i32
    score: f64

foreign last_record_id_rust rust version "2021":
    input records: &[InputRecord]
    output id: u64
    sandbox "fs.none"
    code:
        #[repr(C)]
        pub struct InputRecord {
            pub id: u64,
            pub delta: i32,
            pub score: f64,
        }

        #[unsafe(no_mangle)]
        pub unsafe extern "C" fn last_record_id_rust(
            records: *const InputRecord,
            records_len: usize,
        ) -> u64 {
            let records = unsafe { std::slice::from_raw_parts(records, records_len) };
            records.last().map(|record| record.id).unwrap_or(0)
        }

fn last_id_rust(records: &[InputRecord]) -> u64:
    return last_record_id_rust(records)
