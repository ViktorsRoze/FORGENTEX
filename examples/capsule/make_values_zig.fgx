# Native-call v1.22: Zig transfers a broader Vec[i32] through the reviewed ABI.

foreign make_values_zig zig version "0.14" effects [alloc, cpu.avx2]:
    input count: i32
    output values: Vec[i32]
    sandbox "fs.none"
    code:
        const std = @import("std");

        pub const FgxOwnedI32 = extern struct {
            ptr: ?[*]i32,
            len: usize,
            capacity: usize,
        };

        pub export fn make_values_zig(count: i32) FgxOwnedI32 {
            const len: usize = @intCast(@max(count, 0));
            if (len == 0) return .{ .ptr = null, .len = 0, .capacity = 0 };
            const values = std.heap.page_allocator.alloc(i32, len) catch
                return .{ .ptr = null, .len = 0, .capacity = 0 };
            for (values, 0..) |*value, index| {
                const signed_index: i32 = @intCast(index);
                value.* = (signed_index - 2) * 100000;
            }
            return .{ .ptr = values.ptr, .len = values.len, .capacity = values.len };
        }

        pub export fn make_values_zig_free(
            ptr: ?[*]i32,
            len: usize,
            capacity: usize,
        ) void {
            _ = len;
            if (ptr) |values| std.heap.page_allocator.free(values[0..capacity]);
        }

fn values_from_zig(count: i32) -> Vec[i32] effects [alloc, cpu.avx2]:
    return make_values_zig(count)
