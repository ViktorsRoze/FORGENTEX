# Native data boundaries: multiple logical values cross atomically as one
# reviewed named result struct. General multiple owned outputs remain deferred.

@repr(C)
struct DualOutput:
    result: i32
    status: i32

foreign dual_output_c c version "c11":
    input value: i32
    output outcome: DualOutput
    sandbox "fs.none"
    code:
        #include "types.h"
        #include <stdint.h>

        DualOutput dual_output_c(int32_t value) {
            DualOutput result;
            if (value < 0) {
                result.result = 0;
                result.status = -1;
            } else if (value > 1000) {
                result.result = value / 2;
                result.status = 1;
            } else {
                result.result = value * 2;
                result.status = 0;
            }
            return result;
        }

fn process_value(value: i32) -> DualOutput:
    return dual_output_c(value)
