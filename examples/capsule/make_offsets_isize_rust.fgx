# Native data boundaries: Rust returns an owned pointer-width signed Vec[isize].

foreign make_offsets_isize_rust rust version "2021" effects [alloc]:
    input count: i32
    output offsets: Vec[isize]
    sandbox "fs.none"
    code:
        #[repr(C)]
        pub struct FgxOwnedIsize {
            pub ptr: *mut isize,
            pub len: usize,
            pub capacity: usize,
        }

        #[unsafe(no_mangle)]
        pub extern "C" fn make_offsets_isize_rust(count: i32) -> FgxOwnedIsize {
            let mut values: Vec<isize> = (0..count.max(0))
                .map(|index| (index as isize - 1) * 5_000_000_000isize)
                .collect();
            let result = FgxOwnedIsize {
                ptr: values.as_mut_ptr(),
                len: values.len(),
                capacity: values.capacity(),
            };
            std::mem::forget(values);
            result
        }

        #[unsafe(no_mangle)]
        pub unsafe extern "C" fn make_offsets_isize_rust_free(
            ptr: *mut isize,
            len: usize,
            capacity: usize,
        ) {
            if capacity > 0 {
                drop(unsafe { Vec::from_raw_parts(ptr, len, capacity) });
            }
        }

fn offsets_from_rust(count: i32) -> Vec[isize] effects [alloc]:
    return make_offsets_isize_rust(count)
