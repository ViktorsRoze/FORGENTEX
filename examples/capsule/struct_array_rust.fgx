# Native data boundaries: a fixed-size array of reviewed structs crosses Rust by value.

@repr(C)
struct NativePoint:
    x: i16
    y: i16

@repr(C)
struct PointBatch:
    id: i32
    points: [NativePoint; 3]

foreign shift_points_rust rust version "2021":
    input batch: PointBatch
    output shifted: PointBatch
    sandbox "fs.none"
    code:
        #[repr(C)]
        pub struct NativePoint {
            pub x: i16,
            pub y: i16,
        }

        #[repr(C)]
        pub struct PointBatch {
            pub id: i32,
            pub points: [NativePoint; 3],
        }

        #[unsafe(no_mangle)]
        pub extern "C" fn shift_points_rust(mut batch: PointBatch) -> PointBatch {
            for (index, point) in batch.points.iter_mut().enumerate() {
                point.x += index as i16 + 1;
                point.y -= index as i16 + 1;
            }
            batch
        }

fn shift_points(batch: PointBatch) -> PointBatch:
    return shift_points_rust(batch)
