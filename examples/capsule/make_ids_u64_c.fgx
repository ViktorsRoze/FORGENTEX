# Native data boundaries: C returns a bounded owned Vec[u64].

foreign make_ids_u64_c c version "c11" effects [alloc]:
    input count: i32
    output ids: Vec[u64]
    sandbox "fs.none"
    code:
        #include "types.h"
        #include <stdint.h>
        #include <stdlib.h>

        FgxOwnedU64 make_ids_u64_c(int32_t count) {
            FgxOwnedU64 result = { NULL, 0, 0 };
            if (count <= 0) return result;
            result.ptr = (uint64_t *)malloc((size_t)count * sizeof(uint64_t));
            if (result.ptr == NULL) return result;
            result.len = (size_t)count;
            result.capacity = (size_t)count;
            for (size_t i = 0; i < result.len; ++i) {
                result.ptr[i] = i + 1 == result.len
                    ? UINT64_MAX
                    : 3000000000ULL + (uint64_t)i * 2000000000ULL;
            }
            return result;
        }

        void make_ids_u64_c_free(uint64_t *ptr, size_t len, size_t capacity) {
            (void)len;
            (void)capacity;
            free(ptr);
        }

fn ids_from_c(count: i32) -> Vec[u64] effects [alloc]:
    return make_ids_u64_c(count)
