# Owned-output v1: Rust transfers a Vec[u8] descriptor and frees it explicitly.

foreign make_bytes_rust rust version "2021" effects [alloc, cpu.avx2]:
    input count: i32
    output bytes: Vec[u8]
    sandbox "fs.none"
    sandbox "artifact.media_type application/octet-stream"
    sandbox "artifact.max_bytes 1048576"
    code:
        #[repr(C)]
        pub struct FgxOwnedU8 {
            pub ptr: *mut u8,
            pub len: usize,
            pub capacity: usize,
        }

        #[unsafe(no_mangle)]
        pub extern "C" fn make_bytes_rust(count: i32) -> FgxOwnedU8 {
            let mut bytes: Vec<u8> = (0..count.max(0)).map(|index| (index + 1) as u8).collect();
            let result = FgxOwnedU8 {
                ptr: bytes.as_mut_ptr(),
                len: bytes.len(),
                capacity: bytes.capacity(),
            };
            std::mem::forget(bytes);
            result
        }

        #[unsafe(no_mangle)]
        pub unsafe extern "C" fn make_bytes_rust_free(ptr: *mut u8, len: usize, capacity: usize) {
            if capacity > 0 {
                drop(unsafe { Vec::from_raw_parts(ptr, len, capacity) });
            }
        }

fn bytes_from_rust(count: i32) -> Vec[u8] effects [alloc, cpu.avx2]:
    return make_bytes_rust(count)
