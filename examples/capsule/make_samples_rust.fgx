# Native-call v1.19: Rust transfers a Vec[i16] with explicit ownership.

foreign make_samples_rust rust version "2021" effects [alloc, cpu.avx2]:
    input count: i32
    output samples: Vec[i16]
    sandbox "fs.none"
    code:
        #[repr(C)]
        pub struct FgxOwnedI16 {
            pub ptr: *mut i16,
            pub len: usize,
            pub capacity: usize,
        }

        #[unsafe(no_mangle)]
        pub extern "C" fn make_samples_rust(count: i32) -> FgxOwnedI16 {
            let mut samples: Vec<i16> = (0..count.max(0))
                .map(|index| ((index - 2) * 100) as i16)
                .collect();
            let result = FgxOwnedI16 {
                ptr: samples.as_mut_ptr(),
                len: samples.len(),
                capacity: samples.capacity(),
            };
            std::mem::forget(samples);
            result
        }

        #[unsafe(no_mangle)]
        pub unsafe extern "C" fn make_samples_rust_free(
            ptr: *mut i16,
            len: usize,
            capacity: usize,
        ) {
            if capacity > 0 {
                drop(unsafe { Vec::from_raw_parts(ptr, len, capacity) });
            }
        }

fn samples_from_rust(count: i32) -> Vec[i16] effects [alloc, cpu.avx2]:
    return make_samples_rust(count)
