# Native data boundaries: a fixed-size scalar array field crosses pinned Zig 0.14 by value.

@repr(C)
struct SampleWindow:
    id: i32
    samples: [i16; 4]

foreign fixed_samples_zig zig version "0.14":
    input window: SampleWindow
    output adjusted: SampleWindow
    sandbox "fs.none"
    code:
        pub const SampleWindow = extern struct {
            id: i32,
            samples: [4]i16,
        };

        pub export fn fixed_samples_zig(window: SampleWindow) SampleWindow {
            var adjusted = window;
            adjusted.samples[0] += 1;
            adjusted.samples[1] += 2;
            adjusted.samples[2] += 3;
            adjusted.samples[3] += 4;
            return adjusted;
        }

fn adjust_samples(window: SampleWindow) -> SampleWindow:
    return fixed_samples_zig(window)
