# Zig mutable slice: fixed-length copy-in/copy-back through temporary storage.

foreign add_gain_i16_zig zig version "0.17" effects [cpu.avx2]:
    input samples: &mut [i16]
    input gain: i16
    output changed: i32
    sandbox "fs.none"
    code:
        pub export fn add_gain_i16_zig(samples: [*]i16, samples_len: usize, gain: i16) i32 {
            for (samples[0..samples_len]) |*sample| sample.* += gain;
            return @intCast(samples_len);
        }

fn boost_zig_then_first(samples: &mut [i16]) -> i16 effects [cpu.avx2]:
    let changed: i32 = add_gain_i16_zig(samples, 5)
    return samples[0]
