# Native data boundaries: C returns an owned pointer-width signed Vec[isize].

foreign make_offsets_isize_c c version "c11" effects [alloc]:
    input count: i32
    output offsets: Vec[isize]
    sandbox "fs.none"
    code:
        #include "types.h"
        #include <stddef.h>
        #include <stdlib.h>

        FgxOwnedIsize make_offsets_isize_c(int32_t count) {
            FgxOwnedIsize result = { NULL, 0, 0 };
            if (count <= 0) return result;
            result.ptr = (ptrdiff_t *)malloc((size_t)count * sizeof(ptrdiff_t));
            if (result.ptr == NULL) return result;
            result.len = (size_t)count;
            result.capacity = (size_t)count;
            for (size_t i = 0; i < result.len; ++i) {
                result.ptr[i] = ((ptrdiff_t)i - 1) * (ptrdiff_t)5000000000LL;
            }
            return result;
        }

        void make_offsets_isize_c_free(
            ptrdiff_t *ptr,
            size_t len,
            size_t capacity
        ) {
            (void)len;
            (void)capacity;
            free(ptr);
        }

fn offsets_from_c(count: i32) -> Vec[isize] effects [alloc]:
    return make_offsets_isize_c(count)
