# Native-call v1.22: Zig transfers a Vec[i16] with explicit ownership.

foreign make_samples_zig zig version "0.17" effects [alloc, cpu.avx2]:
    input count: i32
    output samples: Vec[i16]
    sandbox "fs.none"
    code:
        const std = @import("std");

        pub const FgxOwnedI16 = extern struct {
            ptr: ?[*]i16,
            len: usize,
            capacity: usize,
        };

        pub export fn make_samples_zig(count: i32) FgxOwnedI16 {
            const len: usize = @intCast(@max(count, 0));
            if (len == 0) return .{ .ptr = null, .len = 0, .capacity = 0 };
            const samples = std.heap.page_allocator.alloc(i16, len) catch
                return .{ .ptr = null, .len = 0, .capacity = 0 };
            for (samples, 0..) |*sample, index| {
                const signed_index: i32 = @intCast(index);
                sample.* = @intCast((signed_index - 2) * 100);
            }
            return .{ .ptr = samples.ptr, .len = samples.len, .capacity = samples.len };
        }

        pub export fn make_samples_zig_free(
            ptr: ?[*]i16,
            len: usize,
            capacity: usize,
        ) void {
            _ = len;
            if (ptr) |samples| std.heap.page_allocator.free(samples[0..capacity]);
        }

fn samples_from_zig(count: i32) -> Vec[i16] effects [alloc, cpu.avx2]:
    return make_samples_zig(count)
