fn clamp_byte(x: i32) -> i32:
    if x > 255:
        return 255
    return x

test "clamp high":
    expect clamp_byte(400) == 255

test "clamp low":
    expect clamp_byte(7) == 7

xfail test "safe assembly rejected":
    expect_diagnostic ASM001

fn asm_bad(x: u64) -> u64:
    asm x86_64:
        in rax: x
        out rax: y
        op popcnt rax rax
    return y
