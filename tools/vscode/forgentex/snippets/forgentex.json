{
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:param}: ${3:i32}) -> ${4:i32}",
      "    ${5:return ${2:param}}"
    ],
    "description": "Forgentex human syntax function"
  },
  "Unsafe Assembly Stub": {
    "prefix": "unsafe-asm",
    "body": [
      "unsafe fn ${1:name}(${2:value}: ${3:u32}) -> ${4:u32}",
      "    asm ${5:x86_64}",
      "        abi \"${6:sysv64}\"",
      "        clobbers \"${7:cc}\"",
      "    return ${2:value}"
    ],
    "description": "Structured unsafe assembly review stub"
  },
  "Patch Operation": {
    "prefix": "op",
    "body": [
      "VERSION 1",
      "AUTHOR \"${1:agent}\"",
      "TARGET @function.${2:name}",
      "OP ${3:REPLACE_FUNCTION_BODY}",
      "{",
      "  ${4:// replacement body}",
      "}"
    ],
    "description": "Forgentex semantic patch skeleton"
  }
}
