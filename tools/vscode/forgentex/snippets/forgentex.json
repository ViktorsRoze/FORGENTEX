{
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:value}: ${3:i32}) -> ${4:i32}:",
      "    return ${2:value}"
    ],
    "description": "Forgentex function"
  },
  "Function With Effects": {
    "prefix": "fneff",
    "body": [
      "fn ${1:name}(${2:value}: ${3:i32}) -> ${4:i32} effects [${5:alloc}]:",
      "    return ${2:value}"
    ],
    "description": "Forgentex function with a declared effect row"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name}:",
      "    ${2:field}: ${3:i32}"
    ],
    "description": "Forgentex struct"
  },
  "Repr C Struct": {
    "prefix": "reprc",
    "body": [
      "@repr(C)",
      "struct ${1:Name}:",
      "    ${2:field}: ${3:i32}"
    ],
    "description": "Reviewed @repr(C) struct for the native boundary"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name}:",
      "    ${2:First}",
      "    ${3:Second}"
    ],
    "description": "Forgentex enum"
  },
  "Match": {
    "prefix": "match",
    "body": [
      "match ${1:value}:",
      "    case ${2:Name}::${3:First}:",
      "        ${4:return 0}",
      "    case ${2:Name}::${5:Second}:",
      "        ${6:return 1}"
    ],
    "description": "Match over a declared enum"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "let ${1:i}: ${2:i32} = 0",
      "while ${1:i} < ${3:limit}:",
      "    ${4:total} = ${4:total} + ${1:i}",
      "    ${1:i} = ${1:i} + 1"
    ],
    "description": "Counted while loop"
  },
  "Inline Test": {
    "prefix": "test",
    "body": [
      "test \"${1:name}\":",
      "    expect ${2:call()} == ${3:0}"
    ],
    "description": "Inline executable test block"
  },
  "Shared Value": {
    "prefix": "share",
    "body": [
      "share ${1:name}: ${2:i32} = ${3:0}"
    ],
    "description": "Shared typed namespace entry"
  },
  "Foreign C Capsule": {
    "prefix": "foreign",
    "body": [
      "foreign ${1:name} c version \"c11\" effects [${2:alloc}]:",
      "    input ${3:value}: ${4:i32}",
      "    output ${5:result}: ${6:i32}",
      "    sandbox \"fs.none\"",
      "    code:",
      "        #include <stdint.h>",
      "",
      "        int32_t ${1:name}(int32_t ${3:value}) {",
      "            return ${3:value};",
      "        }"
    ],
    "description": "Governed native C capsule"
  },
  "Pipeline": {
    "prefix": "pipeline",
    "body": [
      "pipeline ${1:name}:",
      "    stage ${2:produce}",
      "    stage ${3:consume}",
      "    edge ${2:produce} -> ${3:consume} via ${4:share_name}"
    ],
    "description": "Source-declared deterministic pipeline graph"
  },
  "Unsafe Assembly Stub": {
    "prefix": "unsafe-asm",
    "body": [
      "unsafe fn ${1:name}(${2:value}: ${3:u32}) -> ${4:u32}:",
      "    asm ${5:x86_64}:",
      "        abi \"${6:sysv64}\"",
      "        clobber ${7:cc}",
      "    return ${2:value}"
    ],
    "description": "Structured unsafe assembly review stub"
  },
  "Patch Operation": {
    "prefix": "op",
    "body": [
      "VERSION 1",
      "AUTHOR \"${1:agent}\"",
      "TARGET @function.${2:name}",
      "OP ${3:REPLACE_FUNCTION_BODY}",
      "{",
      "  ${4:// replacement body}",
      "}"
    ],
    "description": "Forgentex semantic patch skeleton"
  }
}
