{
  "name": "forgentex-vscode",
  "displayName": "Forgentex",
  "description": "Editor workflow for Forgentex human, agent, patch, and project-map files.",
  "version": "0.1.0",
  "publisher": "forgentex-demo",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:forgentex-fgx",
    "onLanguage:forgentex-fgai",
    "onLanguage:forgentex-fgp",
    "onLanguage:forgentex-fgmap"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "forgentex-fgx",
        "aliases": [
          "Forgentex Human",
          "fgx"
        ],
        "extensions": [
          ".fgx"
        ],
        "configuration": "./language-configuration/fgx.json"
      },
      {
        "id": "forgentex-fgai",
        "aliases": [
          "Forgentex Agent",
          "fgai"
        ],
        "extensions": [
          ".fgai"
        ],
        "configuration": "./language-configuration/fgai.json"
      },
      {
        "id": "forgentex-fgp",
        "aliases": [
          "Forgentex Patch",
          "fgp"
        ],
        "extensions": [
          ".fgp"
        ],
        "configuration": "./language-configuration/fgp.json"
      },
      {
        "id": "forgentex-fgmap",
        "aliases": [
          "Forgentex Project Map",
          "fgmap"
        ],
        "extensions": [
          ".fgmap"
        ],
        "configuration": "./language-configuration/fgmap.json"
      }
    ],
    "grammars": [
      {
        "language": "forgentex-fgx",
        "scopeName": "source.fgx",
        "path": "./syntaxes/fgx.tmLanguage.json"
      },
      {
        "language": "forgentex-fgai",
        "scopeName": "source.fgai",
        "path": "./syntaxes/fgai.tmLanguage.json"
      },
      {
        "language": "forgentex-fgp",
        "scopeName": "source.fgp",
        "path": "./syntaxes/fgp.tmLanguage.json"
      },
      {
        "language": "forgentex-fgmap",
        "scopeName": "source.fgmap",
        "path": "./syntaxes/fgmap.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "forgentex-fgx",
        "path": "./snippets/forgentex.json"
      },
      {
        "language": "forgentex-fgp",
        "path": "./snippets/forgentex.json"
      }
    ],
    "commands": [
      {
        "command": "forgentex.showHumanAgentViews",
        "title": "Forgentex: Show Human/Agent Views",
        "category": "Forgentex"
      },
      {
        "command": "forgentex.contextForSymbol",
        "title": "Forgentex: Open Symbol Context",
        "category": "Forgentex"
      },
      {
        "command": "forgentex.reviewPatch",
        "title": "Forgentex: Review Semantic Patch",
        "category": "Forgentex"
      },
      {
        "command": "forgentex.applyPatchPreview",
        "title": "Forgentex: Approve Patch Preview",
        "category": "Forgentex"
      },
      {
        "command": "forgentex.runDiagnostics",
        "title": "Forgentex: Run Diagnostics",
        "category": "Forgentex"
      },
      {
        "command": "forgentex.showUnsafeArchitectureSlices",
        "title": "Forgentex: Show Unsafe Architecture Slices",
        "category": "Forgentex"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "forgentex.showHumanAgentViews",
          "when": "resourceExtname == .fgx || resourceExtname == .fgai",
          "group": "navigation@20"
        },
        {
          "command": "forgentex.runDiagnostics",
          "when": "resourceExtname == .fgx || resourceExtname == .fgai",
          "group": "navigation@21"
        }
      ],
      "editor/context": [
        {
          "command": "forgentex.contextForSymbol",
          "when": "resourceExtname == .fgx || resourceExtname == .fgai || resourceExtname == .fgmap",
          "group": "forgentex@10"
        },
        {
          "command": "forgentex.showUnsafeArchitectureSlices",
          "when": "resourceExtname == .fgx || resourceExtname == .fgai || resourceExtname == .fgmap",
          "group": "forgentex@20"
        }
      ],
      "explorer/context": [
        {
          "command": "forgentex.reviewPatch",
          "when": "resourceExtname == .fgp",
          "group": "forgentex@10"
        },
        {
          "command": "forgentex.applyPatchPreview",
          "when": "resourceExtname == .fgp",
          "group": "forgentex@20"
        }
      ]
    },
    "configuration": {
      "title": "Forgentex",
      "properties": {
        "forgentex.fgxPath": {
          "type": "string",
          "default": "fgx",
          "description": "Path to the Forgentex CLI binary."
        },
        "forgentex.defaultDeps": {
          "type": "string",
          "default": "types,effects,tests",
          "description": "Default dependency slices requested by the symbol context command."
        },
        "forgentex.languageServiceMode": {
          "type": "string",
          "enum": [
            "cli",
            "disabled"
          ],
          "default": "cli",
          "description": "Language service integration mode. Stage 20 uses the fgx CLI as the editor language service."
        },
        "forgentex.checkOnType": {
          "type": "boolean",
          "default": true,
          "description": "Re-check the file with fgx while typing. Unsaved buffers are mirrored to a scratch file so diagnostics track the editor, not the last save."
        },
        "forgentex.checkDelayMs": {
          "type": "number",
          "default": 400,
          "minimum": 200,
          "description": "Debounce delay in milliseconds before a check-on-type run. Values below 200 are clamped."
        }
      }
    },
    "problemMatchers": [
      {
        "name": "forgentex",
        "owner": "forgentex",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        }
      }
    ],
    "debuggers": [
      {
        "type": "forgentex",
        "label": "Forgentex",
        "program": "./adapter.js",
        "runtime": "node",
        "languages": [
          "forgentex-fgx",
          "forgentex-fgai"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program",
              "entry"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the .fgx file to debug.",
                "default": "${file}"
              },
              "entry": {
                "type": "string",
                "description": "Function to run.",
                "default": "main"
              },
              "input": {
                "type": "string",
                "description": "JSON input document for the entry arguments.",
                "default": "{}"
              },
              "live": {
                "type": "boolean",
                "description": "Execute foreign capsules for real.",
                "default": false
              },
              "allowEffects": {
                "type": "string",
                "description": "Comma-separated effect grants for live capsules."
              },
              "grantFs": {
                "type": "string",
                "description": "Comma-separated hosted filesystem grants."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "forgentex",
            "request": "launch",
            "name": "Debug Forgentex file",
            "program": "${file}",
            "entry": "main"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Forgentex: Debug a file",
            "description": "Run a Forgentex entry function under the debugger.",
            "body": {
              "type": "forgentex",
              "request": "launch",
              "name": "Debug Forgentex file",
              "program": "^\"${file}\"",
              "entry": "main"
            }
          }
        ]
      }
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The extension runs the fgx binary named by workspace settings."
    }
  }
}
