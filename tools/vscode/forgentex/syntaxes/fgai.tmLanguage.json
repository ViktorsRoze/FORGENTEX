{
  "name": "Forgentex Agent",
  "scopeName": "source.fgai",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#nodeIds" },
    { "include": "#effects" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#symbols" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.fgai",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.fgai",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.fgai",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "nodeIds": {
      "patterns": [
        {
          "name": "entity.name.tag.node-id.fgai",
          "match": "@(?:function|struct|module|statement|expression)\\.[A-Za-z0-9_.]+"
        }
      ]
    },
    "effects": {
      "patterns": [
        {
          "name": "support.constant.effect.fgai",
          "match": "\\b(?:cpu|target|crypto|network|fs|io|agent|ledger|memory)\\.[A-Za-z0-9_]+\\b"
        },
        {
          "name": "support.constant.architecture.fgai",
          "match": "\\b(?:x86_64|aarch64|arm64|armv7|riscv32|riscv64|risc-v)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.fgai",
          "match": "\\b(?:M|S|F|UF|P|R|L|IF|FOR|CALL|RET|REQ|ASM|EFFECTS|FIELD|PARAM|BODY|TARGET|ABI)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.fgai",
          "match": "\\b(?:bool|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|usize|void)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.fgai",
          "match": "\\b(?:0x[0-9A-Fa-f_]+|[0-9][0-9_]*(?:\\.[0-9_]+)?)\\b"
        }
      ]
    },
    "symbols": {
      "patterns": [
        {
          "name": "entity.name.function.fgai",
          "match": "\\b(?:F|UF)\\s+([A-Za-z_][A-Za-z0-9_]*)"
        },
        {
          "name": "entity.name.type.struct.fgai",
          "match": "\\bS\\s+([A-Za-z_][A-Za-z0-9_]*)"
        }
      ]
    }
  }
}
