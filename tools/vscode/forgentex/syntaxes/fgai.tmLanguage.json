{
  "name": "Forgentex Agent",
  "scopeName": "source.fgai",
  "patterns": [
    {
      "include": "#projectFs"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#nodeIds"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#capsule"
    },
    {
      "include": "#pipeline"
    },
    {
      "include": "#effects"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#types"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#paths"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.fgai",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.fgai",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.fgai",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "nodeIds": {
      "patterns": [
        {
          "name": "entity.name.tag.node-id.fgai",
          "match": "@(?:function|struct|enum|trait|impl|module|capsule|share|pipeline|statement|expression)\\.[A-Za-z0-9_.]+"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "^\\s*(UF|F)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.fgai"
            },
            "2": {
              "name": "entity.name.function.fgai"
            }
          }
        },
        {
          "match": "^\\s*(EN|S|TR|IM)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.type.fgai"
            },
            "2": {
              "name": "entity.name.type.fgai"
            }
          }
        },
        {
          "match": "^\\s*(SHARE)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.share.fgai"
            },
            "2": {
              "name": "variable.other.share.fgai"
            }
          }
        },
        {
          "match": "^\\s*(M|IMPORT|EXPORT)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": {
              "name": "keyword.control.import.fgai"
            },
            "2": {
              "name": "entity.name.namespace.fgai"
            }
          }
        },
        {
          "name": "keyword.declaration.fgai",
          "match": "\\b(?:M|IMPORT|EXPORT|PUB|S|EN|TR|IM|F|UF|CONST|TYPE|SHARE|A)\\b"
        }
      ]
    },
    "capsule": {
      "patterns": [
        {
          "match": "^\\s*(CAP)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(c|cpp|rust|zig|python|javascript|js)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.capsule.fgai"
            },
            "2": {
              "name": "entity.name.function.capsule.fgai"
            },
            "3": {
              "name": "support.constant.language.fgai"
            }
          }
        },
        {
          "name": "keyword.other.capsule.fgai",
          "match": "\\b(?:CAP|CAPREF|ENDCAP|IN|OUT|SBX|CODE|BIND|DEP|ENV|MOCK)\\b"
        },
        {
          "name": "storage.modifier.binding.fgai",
          "match": "\\b(?:read|rw|move|update)\\b"
        }
      ]
    },
    "pipeline": {
      "patterns": [
        {
          "match": "^\\s*(PIPELINE)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.pipeline.fgai"
            },
            "2": {
              "name": "entity.name.section.pipeline.fgai"
            }
          }
        },
        {
          "name": "keyword.other.pipeline.fgai",
          "match": "\\b(?:PIPELINE|ENDPIPELINE|STAGE|EDGE|VIA)\\b"
        }
      ]
    },
    "effects": {
      "patterns": [
        {
          "name": "keyword.other.effects.fgai",
          "match": "\\beffects\\b"
        },
        {
          "name": "support.constant.effect.fgai",
          "match": "\\b(?:alloc|cpu|target|crypto|network|fs|io|agent|ledger|memory|media|gpu|concurrency|serialize|stream)(?:\\.[A-Za-z0-9_]+)?\\b"
        },
        {
          "name": "support.constant.architecture.fgai",
          "match": "\\b(?:x86_64|aarch64|arm64|armv7|riscv32|riscv64|risc-v)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.fgai",
          "match": "\\b(?:IF|EI|EL|MT)\\b"
        },
        {
          "name": "keyword.control.loop.fgai",
          "match": "\\b(?:FOR|WH|BR|CN|I)\\b"
        },
        {
          "name": "keyword.control.flow.fgai",
          "match": "\\b(?:R|REQ)\\b"
        },
        {
          "name": "keyword.other.test.fgai",
          "match": "\\b(?:TEST|XTEST|EXPECT_DIAGNOSTIC|EXPECT)\\b"
        },
        {
          "name": "keyword.declaration.variable.fgai",
          "match": "\\b(?:LET|SET)\\b"
        },
        {
          "name": "keyword.other.asm.fgai",
          "match": "\\b(?:ASM|OP|CLOBBER|ABI)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.fgai",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "variable.language.self.fgai",
          "match": "\\b(?:self|Self)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.fgai",
          "match": "\\b(?:bool|i8|i16|i32|i64|isize|u8|u16|u32|u64|usize|f32|f64|str|void)\\b"
        },
        {
          "name": "support.type.builtin.fgai",
          "match": "\\b(?:Vec|Map|Set|Option|Result|Path|DirEntry|Task|TaskGroup|String|Fn|forall)\\b"
        },
        {
          "name": "entity.name.type.fgai",
          "match": "\\b[A-Z][a-z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.fgai",
          "match": "\\b0x[0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.fgai",
          "match": "\\b[0-9][0-9_]*(?:\\.[0-9_]+)?\\b"
        }
      ]
    },
    "paths": {
      "patterns": [
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*)(::)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "entity.name.type.fgai"
            },
            "2": {
              "name": "punctuation.separator.path.fgai"
            },
            "3": {
              "name": "variable.other.enummember.fgai"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.fgai",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.range.fgai",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.fgai",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.fgai",
          "match": "\\|\\||&&|!"
        },
        {
          "name": "keyword.operator.borrow.fgai",
          "match": "&mut|&"
        },
        {
          "name": "keyword.operator.arithmetic.fgai",
          "match": "\\+|-|\\*|/|%|<<|>>|\\^|\\|"
        },
        {
          "name": "keyword.operator.assignment.fgai",
          "match": "="
        }
      ]
    },
    "projectFs": {
      "patterns": [
        {
          "name": "meta.section.data.fgai",
          "begin": "^(DATA)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+([A-Za-z0-9_.+-]+)\\s*$",
          "end": "^(ENDDATA)\\s*$",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.section.fgai"
            },
            "2": {
              "name": "entity.name.section.data.fgai"
            },
            "3": {
              "name": "support.constant.shape.fgai"
            }
          },
          "endCaptures": {
            "1": {
              "name": "keyword.declaration.section.fgai"
            }
          },
          "patterns": [
            {
              "include": "#sectionMeta"
            },
            {
              "begin": "^(BODY)\\s+([0-9]+)\\s*$",
              "end": "(?=^ENDDATA\\s*$)",
              "beginCaptures": {
                "1": {
                  "name": "keyword.other.section-block.fgai"
                },
                "2": {
                  "name": "constant.numeric.line-count.fgai"
                }
              },
              "contentName": "string.unquoted.payload.fgai"
            }
          ]
        },
        {
          "name": "meta.section.blob.fgai",
          "begin": "^(BLOB)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(\"[^\"]*\")\\s*$",
          "end": "^(ENDBLOB)\\s*$",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.section.fgai"
            },
            "2": {
              "name": "entity.name.section.blob.fgai"
            },
            "3": {
              "name": "support.type.media.fgai"
            }
          },
          "endCaptures": {
            "1": {
              "name": "keyword.declaration.section.fgai"
            }
          },
          "patterns": [
            {
              "include": "#sectionMeta"
            },
            {
              "begin": "^(B64)\\s+([0-9]+)\\s*$",
              "end": "(?=^ENDBLOB\\s*$)",
              "beginCaptures": {
                "1": {
                  "name": "keyword.other.section-block.fgai"
                },
                "2": {
                  "name": "constant.numeric.line-count.fgai"
                }
              },
              "contentName": "comment.block.base64.fgai"
            }
          ]
        },
        {
          "name": "meta.section.note.fgai",
          "begin": "^(NOTE)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(ON)\\s+(\"@[^\"]*\")\\s*$",
          "end": "^(ENDNOTE)\\s*$",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.note.fgai"
            },
            "2": {
              "name": "entity.name.section.note.fgai"
            },
            "3": {
              "name": "keyword.other.note.fgai"
            },
            "4": {
              "name": "markup.underline.link.node-id.fgai"
            }
          },
          "endCaptures": {
            "1": {
              "name": "keyword.declaration.note.fgai"
            }
          },
          "patterns": [
            {
              "match": "^(BY)\\s+\"(agent):([^\"]*)\"",
              "captures": {
                "1": {
                  "name": "keyword.other.note.fgai"
                },
                "2": {
                  "name": "markup.bold.author.agent.fgai"
                },
                "3": {
                  "name": "entity.name.tag.author.agent.fgai"
                }
              }
            },
            {
              "match": "^(BY|CRT|RE|ST)\\b",
              "captures": {
                "1": {
                  "name": "keyword.other.note.fgai"
                }
              }
            },
            {
              "begin": "^(TXT)\\s+([0-9]+)\\s*$",
              "end": "(?=^ENDNOTE\\s*$)",
              "beginCaptures": {
                "1": {
                  "name": "keyword.other.section-block.fgai"
                },
                "2": {
                  "name": "constant.numeric.line-count.fgai"
                }
              },
              "contentName": "meta.embedded.block.markdown",
              "patterns": [
                {
                  "include": "text.html.markdown"
                }
              ]
            }
          ]
        },
        {
          "name": "keyword.other.section.fgai",
          "match": "\\b(?:DATA|ENDDATA|BODY|BLOB|ENDBLOB|B64|SIZE|HASH|STORE|NOTE|ENDNOTE|TXT|CRT|MOD|BY|ON|RE|ST)\\b"
        }
      ]
    },
    "sectionMeta": {
      "patterns": [
        {
          "match": "^(CRT|MOD)\\s+(\"[^\"]*\")(?:\\s+(BY)\\s+(\"[^\"]*\"))?",
          "captures": {
            "1": {
              "name": "keyword.other.section-meta.fgai"
            },
            "2": {
              "name": "constant.other.timestamp.fgai"
            },
            "3": {
              "name": "keyword.other.section-meta.fgai"
            },
            "4": {
              "name": "entity.name.tag.author.fgai"
            }
          }
        },
        {
          "match": "^(SIZE)\\s+([0-9]+)",
          "captures": {
            "1": {
              "name": "keyword.other.section-meta.fgai"
            },
            "2": {
              "name": "constant.numeric.bytes.fgai"
            }
          }
        },
        {
          "match": "^(HASH|STORE)\\s+(\"[^\"]*\")",
          "captures": {
            "1": {
              "name": "keyword.other.section-meta.fgai"
            },
            "2": {
              "name": "constant.other.digest.fgai"
            }
          }
        }
      ]
    }
  }
}
