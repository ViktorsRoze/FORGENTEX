                }
              ]
            }
          ]
        },
        {
          "name": "meta.section.data.xml.fgx",
          "begin": "^(\\s*)(data)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(xml)\\s*:\\s*$",
          "end": "^(?!\\1\\s|\\s*$)",
          "beginCaptures": {
            "2": {
              "name": "keyword.declaration.section.fgx"
            },
            "3": {
              "name": "entity.name.section.data.fgx"
            },
            "4": {
              "name": "support.constant.shape.fgx"
            }
          },
          "patterns": [
            {
              "include": "#sectionMeta"
            },
            {
