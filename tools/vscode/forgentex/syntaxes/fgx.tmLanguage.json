{
  "name": "Forgentex Human",
  "scopeName": "source.fgx",
  "patterns": [
    {
      "include": "#projectFs"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#nodeIds"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#capsule"
    },
    {
      "include": "#pipeline"
    },
    {
      "include": "#effects"
    },
    {
      "include": "#assembly"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#types"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#paths"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#calls"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.annotation.fgx",
          "match": "#@\\s*[A-Za-z0-9_.-]+.*$"
        },
        {
          "name": "comment.line.number-sign.fgx",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.fgx",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.fgx",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "match": "(@)(repr|packed|aligned|endian|extern)\\b",
          "captures": {
            "1": {
              "name": "punctuation.definition.attribute.fgx"
            },
            "2": {
              "name": "storage.modifier.attribute.fgx"
            }
          }
        }
      ]
    },
    "nodeIds": {
      "patterns": [
        {
          "name": "entity.name.tag.node-id.fgx",
          "match": "@(?:function|struct|enum|trait|impl|module|capsule|share|pipeline|statement|expression)\\.[A-Za-z0-9_.]+"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.fgx"
            },
            "2": {
              "name": "entity.name.function.fgx"
            }
          }
        },
        {
          "match": "\\b(struct|enum|trait)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.type.fgx"
            },
            "2": {
              "name": "entity.name.type.fgx"
            }
          }
        },
        {
          "match": "\\b(impl)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(for)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.impl.fgx"
            },
            "2": {
              "name": "entity.name.type.trait.fgx"
            },
            "3": {
              "name": "keyword.declaration.impl.fgx"
            },
            "4": {
              "name": "entity.name.type.fgx"
            }
          }
        },
        {
          "match": "\\b(module|import|export)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": {
              "name": "keyword.control.import.fgx"
            },
            "2": {
              "name": "entity.name.namespace.fgx"
            }
          }
        },
        {
          "match": "\\b(share)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.share.fgx"
            },
            "2": {
              "name": "variable.other.share.fgx"
            }
          }
        },
        {
          "name": "keyword.declaration.fgx",
          "match": "\\b(?:module|import|export|pub|struct|enum|trait|impl|requires|default|fn|const|type|share|test)\\b"
        }
      ]
    },
    "capsule": {
      "patterns": [
        {
          "match": "\\b(foreign)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(c|cpp|rust|zig|python|javascript|js)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.capsule.fgx"
            },
            "2": {
              "name": "entity.name.function.capsule.fgx"
            },
            "3": {
              "name": "support.constant.language.fgx"
            }
          }
        },
        {
          "name": "keyword.other.capsule.fgx",
          "match": "\\b(?:foreign|capsule|version|input|output|sandbox|code|bind|dep|env|mock)\\b"
        },
        {
          "name": "storage.modifier.binding.fgx",
          "match": "\\b(?:read|rw|move|update)\\b"
        }
      ]
    },
    "pipeline": {
      "patterns": [
        {
          "match": "\\b(pipeline)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.pipeline.fgx"
            },
            "2": {
              "name": "entity.name.section.pipeline.fgx"
            }
          }
        },
        {
          "name": "keyword.other.pipeline.fgx",
          "match": "\\b(?:pipeline|stage|edge|via)\\b"
        }
      ]
    },
    "effects": {
      "patterns": [
        {
          "name": "keyword.other.effects.fgx",
          "match": "\\beffects\\b"
        },
        {
          "name": "support.constant.effect.fgx",
          "match": "\\b(?:alloc|cpu|target|crypto|network|fs|io|agent|ledger|memory|media|gpu|concurrency|serialize|stream)(?:\\.[A-Za-z0-9_]+)?\\b"
        },
        {
          "name": "support.constant.architecture.fgx",
          "match": "\\b(?:x86_64|aarch64|arm64|armv7|riscv32|riscv64|risc-v)\\b"
        }
      ]
    },
    "assembly": {
      "patterns": [
        {
          "name": "keyword.control.unsafe.fgx",
          "match": "\\bunsafe\\b"
        },
        {
          "name": "keyword.other.asm.fgx",
          "match": "\\b(?:asm|ASM|abi|clobber|clobbers|inputs|outputs|in|out|op)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.fgx",
          "match": "\\b(?:if|else|match|case)\\b"
        },
        {
          "name": "keyword.control.loop.fgx",
          "match": "\\b(?:for|in|while|break|continue)\\b"
        },
        {
          "name": "keyword.control.flow.fgx",
          "match": "\\b(?:return|require)\\b"
        },
        {
          "name": "keyword.other.test.fgx",
          "match": "\\b(?:expect_diagnostic|expect)\\b"
        },
        {
          "name": "keyword.declaration.variable.fgx",
          "match": "\\b(?:let|mut|as)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.fgx",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "variable.language.self.fgx",
          "match": "\\b(?:self|Self)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.fgx",
          "match": "\\b(?:bool|i8|i16|i32|i64|isize|u8|u16|u32|u64|usize|f32|f64|str|void)\\b"
        },
        {
          "name": "support.type.builtin.fgx",
          "match": "\\b(?:Vec|Map|Set|Option|Result|Path|DirEntry|Task|TaskGroup|String|Fn|forall)\\b"
        },
        {
          "name": "entity.name.type.fgx",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.fgx",
          "match": "\\b0x[0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.fgx",
          "match": "\\b[0-9][0-9_]*(?:\\.[0-9_]+)?\\b"
        }
      ]
    },
    "paths": {
      "patterns": [
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*)(::)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "entity.name.type.fgx"
            },
            "2": {
              "name": "punctuation.separator.path.fgx"
            },
            "3": {
              "name": "variable.other.enummember.fgx"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.fgx",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.range.fgx",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.fgx",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.fgx",
          "match": "\\|\\||&&|!"
        },
        {
          "name": "keyword.operator.borrow.fgx",
          "match": "&mut|&"
        },
        {
          "name": "keyword.operator.arithmetic.fgx",
          "match": "\\+|-|\\*|/|%|<<|>>|\\^|\\|"
        },
        {
          "name": "keyword.operator.assignment.fgx",
          "match": "="
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.fgx"
            }
          }
        }
      ]
    },
    "projectFs": {
      "patterns": [
        {
          "name": "meta.section.data.json.fgx",
          "begin": "^(\\s*)(data)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(json)\\s*:\\s*$",
          "end": "^(?!\\1\\s|\\s*$)",
          "beginCaptures": {
            "2": {
              "name": "keyword.declaration.section.fgx"
            },
            "3": {
              "name": "entity.name.section.data.fgx"
            },
            "4": {
              "name": "support.constant.shape.fgx"
            }
          },
          "patterns": [
            {
              "include": "#sectionMeta"
            },
            {
              "begin": "^(\\s*)(content):\\s*$",
              "end": "^(?!\\1\\s|\\s*$)",
              "beginCaptures": {
                "2": {
                  "name": "keyword.other.section-block.fgx"
                }
              },
              "contentName": "meta.embedded.block.source.json",
              "patterns": [
                {
                  "include": "source.json"
                }
              ]
            }
          ]
        },
        {
          "name": "meta.section.data.ndjson.fgx",
          "begin": "^(\\s*)(data)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(ndjson)\\s*:\\s*$",
          "end": "^(?!\\1\\s|\\s*$)",
          "beginCaptures": {
            "2": {
              "name": "keyword.declaration.section.fgx"
            },
            "3": {
              "name": "entity.name.section.data.fgx"
            },
            "4": {
              "name": "support.constant.shape.fgx"
            }
          },
          "patterns": [
            {
              "include": "#sectionMeta"
            },
            {
              "begin": "^(\\s*)(content):\\s*$",
              "end": "^(?!\\1\\s|\\s*$)",
              "beginCaptures": {
                "2": {
                  "name": "keyword.other.section-block.fgx"
                }
              },
              "contentName": "meta.embedded.block.source.json",
              "patterns": [
                {
                  "include": "source.json"
                }
              ]
            }
          ]
        },
        {
          "name": "meta.section.data.yaml.fgx",
          "begin": "^(\\s*)(data)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(yaml)\\s*:\\s*$",
          "end": "^(?!\\1\\s|\\s*$)",
          "beginCaptures": {
            "2": {
              "name": "keyword.declaration.section.fgx"
            },
            "3": {
              "name": "entity.name.section.data.fgx"
            },
            "4": {
              "name": "support.constant.shape.fgx"
            }
          },
          "patterns": [
