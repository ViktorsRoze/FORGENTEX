          },
          "patterns": [
            {
              "match": "^\\s*(by)\\s+\"(agent):([^\"]*)\"",
              "captures": {
                "1": {
                  "name": "keyword.other.note.fgx"
                },
                "2": {
                  "name": "markup.bold.author.agent.fgx"
                },
                "3": {
