              "end": "^(?!\\1\\s|\\s*$)",
              "beginCaptures": {
                "2": {
                  "name": "keyword.other.section-block.fgx"
                }
              },
              "contentName": "meta.embedded.block.text.xml",
              "patterns": [
                {
                  "include": "text.xml"
                }
              ]
            }
          ]
        },
        {
          "name": "meta.section.data.sql.fgx",
          "begin": "^(\\s*)(data)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(sql)\\s*:\\s*$",
          "end": "^(?!\\1\\s|\\s*$)",
          "beginCaptures": {
